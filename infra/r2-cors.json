{
  "rules": [
    {
      "id": "v2-direct-attachment-upload",
      "allowed": {
        "origins": [
          "https://project-light-house.gogo0691.workers.dev",
          "http://localhost:3000"
        ],
        "methods": ["PUT"],
        "headers": [
          "content-type",
          "x-amz-checksum-sha256",
          "x-amz-meta-reservationid",
          "x-amz-meta-userid"
        ]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
